# Copy to .env and fill in.  .env is gitignored and must never be committed.
# Generate ENCRYPTION_KEY with:  python -m app.cli keygen

# ---------------------------------------------------------------- database
POSTGRES_USER=bridge
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=bridge
# Set automatically inside docker-compose; only needed when running outside it.
# DATABASE_URL=postgresql+psycopg://bridge:change-me@localhost:5432/bridge

# -------------------------------------------------------------- FazerCards
FAZERCARDS_BASE_URL=https://api.fzr.cards
FAZERCARDS_API_KEY=fc_your_key_here
FAZERCARDS_RATE_PER_SECOND=5

# --------------------------------------------------------------------- G2A
G2A_BASE_URL=https://api.g2a.com
G2A_CLIENT_ID=
G2A_CLIENT_SECRET=
G2A_RATE_PER_SECOND=4
# G2A caps price changes per product per hour; we stay one under it.
G2A_PRICE_CHANGES_PER_PRODUCT_PER_HOUR=5
G2A_PRICE_CHANGE_SAFETY_MARGIN=1

# ----------------------------------------------------------------- secrets
ENCRYPTION_KEY=
ADMIN_API_TOKEN=

# ----------------------------------------------------------------- pricing
DEFAULT_MARKUP_PERCENT=15
STORE_CURRENCY=EUR
SUPPLIER_CURRENCY=USD
# Leave FX_RATE_USD_EUR empty to fetch a live rate daily; set it to pin a fixed one.
FX_RATE_USD_EUR=
FX_PROVIDER_URL=https://api.frankfurter.app/latest?from=USD&to=EUR
FX_MAX_AGE_HOURS=24
PRICE_ROUNDING=0.01
MIN_OFFER_PRICE=0.30

# ---------------------------------------------------------------- matching
MATCH_AUTO_ACCEPT_SCORE=0.92
MATCH_REVIEW_SCORE=0.70

# -------------------------------------------------------------- scheduling
CATALOG_SYNC_MINUTES=60
PRICE_STOCK_SYNC_MINUTES=12
DEACTIVATE_MISSING_AFTER_RUNS=2

# ------------------------------------------------------------------- other
ENVIRONMENT=production
LOG_LEVEL=INFO
